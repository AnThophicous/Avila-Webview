{
  "app": {
    "id": "com.example.securefiles",
    "name": "Secure Files",
    "version": "1.0.0",
    "entry": "src/index.html",
    "icon": ""
  },
  "window": {
    "width": 960,
    "height": 620,
    "minWidth": 720,
    "minHeight": 480,
    "center": true,
    "resizable": true,
    "borderless": false,
    "roundedCorners": true,
    "cornerPreference": "round",
    "mica": true,
    "micaAlt": false,
    "acrylic": false,
    "blur": false,
    "transparent": false,
    "customTitleBar": true,
    "draggable": true,
    "dragRegions": ["[data-avila-drag]"],
    "noDragRegions": ["button", "input", "textarea", "select", "a", "[data-avila-no-drag]"]
  },
  "security": {
    "defaultPolicy": "deny",
    "allowRemoteContent": false,
    "allowedOrigins": ["avila://local"],
    "devtools": false,
    "sanitizeLogs": true,
    "maxPayloadBytes": 1048576,
    "bridgeTimeoutMs": 5000,
    "tokenSecurity": "session-capability"
  },
  "permissions": {
    "app.info": true,
    "system.ping": true,
    "window.setMica": true,
    "window.setRoundedCorners": true,
    "browser.canGoBack": false,
    "browser.canGoForward": false,
    "browser.navigate": false,
    "fs.readFile": true,
    "fs.writeFile": true,
    "fs.readText": true,
    "fs.writeText": true,
    "fs.exists": true,
    "fs.stat": true,
    "fs.listDir": true,
    "fs.hash": true
  },
  "fs": {
    "allowedRoots": ["app", "data"],
    "maxReadBytes": 5242880,
    "maxWriteBytes": 5242880,
    "atomicWrites": true
  },
  "performance": {
    "startupBoost": true,
    "preloadBridge": true,
    "warmWorkerPool": true,
    "workerPoolMin": 1,
    "workerPoolMax": 4,
    "shrinkWorkersAfterStartup": true,
    "shrinkDelayMs": 8000,
    "cacheStaticAssets": true,
    "lazyLoadNativeModules": true
  },
  "build": {
    "target": "win-x64",
    "singleFile": true,
    "selfContained": true,
    "nativeAot": false,
    "trim": true,
    "readyToRun": true,
    "outputName": "SecureFiles"
  }
}
